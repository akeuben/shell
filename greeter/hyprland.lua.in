-- Kappashell Greeter Hyprland configuration
-- Hyprland 0.55+

hl.config({
    general = {
        border_size = 0,
        gaps_in = 0,
        gaps_out = 0,
        layout = "dwindle",
    },

    decoration = {
        rounding = 0,
        shadow = {
            enabled = false,
        },
    },

    animations = {
        enabled = false,
    },

    input = {
        kb_layout = "us",
        follow_mouse = 0,
        sensitivity = 0,
    },

    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
    },
})

-- Automatically configure connected monitors
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})

local override = "/etc/kappashell/hyprland.lua"

local f = io.open(override, "r")
if f then
    f:close()
    local ok, err = pcall(dofile, override)
    if not ok then
        print("kappashell: error in " .. override .. ": " .. tostring(err))
    end
end

-- Start Kappashell greeter
hl.on("hyprland.start", function()
    hl.exec_cmd("@GREETER_EXECUTABLE@; hyprctl dispatch \"hl.dsp.exit()\"")
end)
